# ── Groq API ──────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM ───────────────────────────────────────────────────────────────────────
MODEL_NAME=llama-3.1-8b-instant
TEMPERATURE=0.3
MAX_TOKENS=2048

# ── Agent loop ─────────────────────────────────────────────────────────────────
# 1 = simple mode (single LLM call, good for rate-limit testing)
# 3 = full agentic mode (plan → execute → critique → refine)
MAX_ITERATIONS=3

# Maximum number of tool-call rounds per executor task
MAX_TOOL_CALLS=5

# ── Memory ─────────────────────────────────────────────────────────────────────
SHORT_TERM_MEMORY_SIZE=10
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_TOP_K=5

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agentic_system.log
MEMORY_FILE=logs/memory.json

# ── Networking ─────────────────────────────────────────────────────────────────
API_TIMEOUT=30
RETRY_ATTEMPTS=3

# ── Security ───────────────────────────────────────────────────────────────────
# Set to a random secret string to enable X-API-Key auth on all endpoints.
# Leave empty to disable auth (local development only).
API_AUTH_KEY=your_secure_random_secret_here

RATE_LIMIT_PER_MINUTE=20

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
